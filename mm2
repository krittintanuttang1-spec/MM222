local espOn = false
VisualTab:CreateToggle({
   Name = "ESP สีบทบาท (เขียว/แดง/ฟ้า)",
   CurrentValue = false,
   Flag = "ESPFlag",
   Callback = function(Value)
      espOn = Value
      for _, p in pairs(Players:GetPlayers()) do
          if p.Character and p.Character:FindFirstChild("EXZ_ESP_BOX") then
              p.Character.EXZ_ESP_BOX:Destroy()
          end
      end
   end,
})

RunService.RenderStepped:Connect(function()
    pcall(function()
        if espOn then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local char = p.Character
                    local hl = char:FindFirstChild("EXZ_ESP_BOX")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "EXZ_ESP_BOX"
                        hl.Parent = char
                        hl.Adornee = char
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                    
                    local role = getRole(p)
                    if role == "Murderer" then
                        hl.FillColor = Color3.fromRGB(255, 50, 50) -- แดง: ฆาตกร
                    elseif role == "Sheriff" then
                        hl.FillColor = Color3.fromRGB(0, 150, 255) -- ฟ้า: นายอำเภอ
                    else
                        hl.FillColor = Color3.fromRGB(50, 255, 50) -- เขียว: คนทั่วไป
                    end
                end
            end
        end
    end)
end)

